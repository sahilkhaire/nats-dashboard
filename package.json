{
  "name": "nats-dashboard",
  "private": true,
  "version": "0.0.13",
  "description": "Open-source web UI to monitor and manage NATS servers, JetStream streams and consumers, KV and Object Store.",
  "keywords": [
    "nats",
    "nats-dashboard",
    "nats-ui",
    "nats-gui",
    "nats-monitoring",
    "jetstream",
    "jetstream-ui",
    "nats-jetstream",
    "nats-kv",
    "nats-object-store",
    "message-queue",
    "messaging",
    "monitoring",
    "dashboard",
    "admin-panel",
    "observability",
    "docker",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Sahil Khaire",
  "homepage": "https://github.com/sahilkhaire/nats-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahilkhaire/nats-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/sahilkhaire/nats-dashboard/issues"
  },
  "type": "module",
  "scripts": {
    "sync-context": "node scripts/sync-nats-context.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "docker:build": "docker build -t sahilkhaire/nats-dashboard:$(node -p \"require('./package.json').version\") -t sahilkhaire/nats-dashboard:latest .",
    "docker:push": "npm run docker:build && docker push sahilkhaire/nats-dashboard:$(node -p \"require('./package.json').version\") && docker push sahilkhaire/nats-dashboard:latest"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "nats": "^2.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
